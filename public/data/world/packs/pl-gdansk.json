pal","sensitive":false,"sourceIds":["pl_en_wikipedia"],"start":"1925-12","summary":"В декабре 1925 г. Лига Наций согласилась на размещение на Вестерплатте польской охраны из 88 человек при польском военном складе.","title":"Польская военная станция на Вестерплатте"},{"approximate":false,"category":"local_economy","confidence":"medium","countries":["PL"],"eligibility":{"groupsAny":[],"maxAge":null,"minAge":null},"end":null,"groups":["dock_workers","industrial_workers"],"hooks":["port_work_moves_to_gdynia"],"id":"pl-gdansk-1932-gdynia-overtakes","impacts":["employment_change"],"legacy":false,"locationIds":["pl-gdansk"],"precision":"month","scope":"municipal","sensitive":false,"sourceIds":["pl_en_wikipedia"],"start":"1932-05","summary":"Польша с 1921 г. строила порт в Гдыне на своём побережье; в мае 1932 г. её внешнеторговый оборот превысил оборот Данцига, через который прежде шёл почти весь польский экспорт.","title":"Гдыня обгоняет Данциг по грузообороту"},{"approximate":false,"category":"political_change","confidence":"medium","countries":["PL"],"eligibility":{"groupsAny":[],"maxAge":null,"minAge":null},"end":null,"groups":["all_residents","ethnic_minorities","jewish_population"],"hooks":[],"id":"pl-gdansk-1933-nazi-majority","impacts":[],"legacy":false,"locationIds":["pl-gdansk"],"precision":"month","scope":"municipal","sensitive":false,"sourceIds":["pl_en_wikipedia"],"start":"1933-05","summary":"На выборах в фольксваг в мае 1933 г. национал-социалисты получили абсолютное большинство.","title":"Нацисты получают большинство в Данциге"},{"approximate":false,"category":"war_conflict","confidence":"medium","countries":["PL"],"eligibility":{"groupsAny":[],"maxAge":null,"minAge":null},"end":"1939-09-07","groups":["all_residents"],"hooks":["first_day_of_war"],"id":"pl-gdansk-1939-westerplatte","impacts":[],"legacy":false,"locationIds":["pl-gdansk"],"precision":"day","scope":"municipal","sensitive":true,"sourceIds":["pl_en_wikipedia"],"start":"1939-09-01","summary":"1 сент